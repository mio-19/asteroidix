From b399c6608964dfaf21b31ba878a42a6b7dc7a712 Mon Sep 17 00:00:00 2001
From: Asteroidix <dev@asteroidix.org>
Date: Sat, 17 Oct 2026 21:07:46 +1100
Subject: [PATCH] BluetoothPage: Add toggle for Bluetooth internet sharing

Allows users to easily enable or disable automatic Bluetooth
internet sharing fallback directly in system settings.
---
 src/qml/BluetoothPage.qml | 106 ++++++++++++++++++++++++++++++++------
 1 file changed, 91 insertions(+), 15 deletions(-)

diff --git a/src/qml/BluetoothPage.qml b/src/qml/BluetoothPage.qml
index 7272fe7..fe2fab0 100644
--- a/src/qml/BluetoothPage.qml
+++ b/src/qml/BluetoothPage.qml
@@ -19,26 +19,102 @@
 import QtQuick
 import org.asteroid.controls
 import org.asteroid.utils
+import Nemo.Configuration
 
 Item {
+    id: root
     property int depth
     property var pop
     BluetoothStatus { id: btStatus }
 
-    StatusPage {
-        //% "Bluetooth on"
-        property string bluetoothOnStr: qsTrId("id-bluetooth-on")
-        //% "Bluetooth off"
-        property string bluetoothOffStr: qsTrId("id-bluetooth-off")
-        //% "Connected"
-        property string connectedStr: qsTrId("id-connected")
-        //% "Not connected"
-        property string notConnectedStr: qsTrId("id-disconnected")
-        text: "<h3>" + (btStatus.powered ? bluetoothOnStr : bluetoothOffStr) + "</h3>\n" + (btStatus.connected ? connectedStr : notConnectedStr)
-        icon: btStatus.powered ? "ios-bluetooth-outline" : "ios-bluetooth-off-outline"
-        clickable: true
-        onClicked: btStatus.powered = !btStatus.powered
-        activeBackground: btStatus.powered
+    ConfigurationValue {
+        id: btInternetSharing
+        key: "/org/asteroidos/settings/bluetooth-internet-sharing"
+        defaultValue: true
     }
-}
 
+    //% "Bluetooth on"
+    property string bluetoothOnStr: qsTrId("id-bluetooth-on")
+    //% "Bluetooth off"
+    property string bluetoothOffStr: qsTrId("id-bluetooth-off")
+    //% "Connected"
+    property string connectedStr: qsTrId("id-connected")
+    //% "Not connected"
+    property string notConnectedStr: qsTrId("id-disconnected")
+
+    Flickable {
+        id: flickable
+        anchors.fill: parent
+        contentHeight: contentColumn.implicitHeight
+        boundsBehavior: Flickable.DragOverBounds
+        flickableDirection: Flickable.VerticalFlick
+
+        Column {
+            id: contentColumn
+            width: parent.width
+
+            Item {
+                width: parent.width
+                height: btStatus.powered ? root.height * 0.65 : root.height
+
+                Rectangle {
+                    id: statusIconBackground
+                    anchors.centerIn: parent
+                    anchors.verticalCenterOffset: -parent.width * 0.1
+                    color: "black"
+                    radius: width / 2
+                    opacity: btStatus.powered ? 0.4 : 0.2
+                    width: parent.width * 0.25
+                    height: width
+
+                    Icon {
+                        anchors.fill: parent
+                        anchors.margins: parent.width * 0.12
+                        name: btStatus.powered ? "ios-bluetooth" : "ios-bluetooth-off-outline"
+                    }
+
+                    MouseArea {
+                        anchors.fill: parent
+                        onClicked: btStatus.powered = !btStatus.powered
+                    }
+                }
+
+                Label {
+                    font.pixelSize: parent.width * 0.05
+                    horizontalAlignment: Text.AlignHCenter
+                    verticalAlignment: Text.AlignVCenter
+                    wrapMode: Text.Wrap
+                    anchors.left: parent.left
+                    anchors.right: parent.right
+                    anchors.leftMargin: parent.width * 0.04
+                    anchors.rightMargin: anchors.leftMargin
+                    anchors.top: statusIconBackground.bottom
+                    anchors.topMargin: parent.width * 0.04
+                    text: "<h3>" + (btStatus.powered ? bluetoothOnStr : bluetoothOffStr) + "</h3>\n" + (btStatus.powered ? (btStatus.connected ? connectedStr : notConnectedStr) : "")
+                }
+            }
+
+            RowSeparator { visible: btStatus.powered }
+
+            LabeledSwitch {
+                id: sharingSwitch
+                visible: btStatus.powered
+                width: parent.width
+                height: Dims.h(25)
+                text: "Internet sharing"
+                checked: btInternetSharing.value
+                onCheckedChanged: {
+                    if (btInternetSharing.value !== checked) {
+                        btInternetSharing.value = checked
+                    }
+                }
+            }
+
+            Item {
+                visible: btStatus.powered
+                width: parent.width
+                height: Dims.h(10)
+            }
+        }
+    }
+}
-- 
2.55.0

