From 862ef93bdd3d4132a038f77c8b48d7971731b493 Mon Sep 17 00:00:00 2001
From: Asteroidix <dev@asteroidix.org>
Date: Sun, 18 Oct 2026 03:15:57 +1100
Subject: [PATCH] Support 32-bit ARM in AK and LibGC

- Define AK_IS_ARCH_ARM() in AK/Platform.h for 32-bit ARM architectures.
- Adjust NanBoxedValue assertion from sizeof(void*) == sizeof(u64) to
  sizeof(void*) <= sizeof(u64) since 32-bit pointers fit within the 48-bit
  NaN payload.
- Define a 256 MiB HEAP_REGION_SIZE for 32-bit architectures in LibGC/HeapRegion.h
  fitting within the 32-bit virtual address space.
- Change static_assert in BlockAllocator.cpp to sizeof(FlatPtr) >= sizeof(void*).

Upstream-Status: Inappropriate [Architecture enablement for resource-constrained 32-bit systems]
Signed-off-by: Antigravity <antigravity@google.com>
---
 AK/Platform.h                      | 6 ++++++
 Libraries/LibGC/BlockAllocator.cpp | 2 +-
 Libraries/LibGC/HeapRegion.h       | 2 ++
 Libraries/LibGC/NanBoxedValue.h    | 2 +-
 4 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/AK/Platform.h b/AK/Platform.h
index a95420d..e336090 100644
--- a/AK/Platform.h
+++ b/AK/Platform.h
@@ -33,6 +33,12 @@
 #    define AK_IS_ARCH_AARCH64() 0
 #endif
 
+#if defined(__arm__) || defined(__thumb__) || defined(_M_ARM)
+#    define AK_IS_ARCH_ARM() 1
+#else
+#    define AK_IS_ARCH_ARM() 0
+#endif
+
 #if defined(__riscv) && __riscv_xlen == 64
 #    define AK_IS_ARCH_RISCV64() 1
 #else
diff --git a/Libraries/LibGC/BlockAllocator.cpp b/Libraries/LibGC/BlockAllocator.cpp
index a50dadd..77ecfd1 100644
--- a/Libraries/LibGC/BlockAllocator.cpp
+++ b/Libraries/LibGC/BlockAllocator.cpp
@@ -55,7 +55,7 @@ public:
 
     HeapRegion()
     {
-        static_assert(sizeof(FlatPtr) >= sizeof(u64));
+        static_assert(sizeof(FlatPtr) >= sizeof(void*));
         Checked<size_t> reservation_size = size;
         reservation_size += size;
         VERIFY(!reservation_size.has_overflow());
diff --git a/Libraries/LibGC/HeapRegion.h b/Libraries/LibGC/HeapRegion.h
index e8f3128..2c29eaa 100644
--- a/Libraries/LibGC/HeapRegion.h
+++ b/Libraries/LibGC/HeapRegion.h
@@ -18,6 +18,8 @@ namespace GC {
 // address space between userspace and the kernel. Keep room for the second
 // region-sized reservation used to align the cage base.
 static constexpr size_t HEAP_REGION_SIZE = 64ull * GiB;
+#elif AK_IS_ARCH_ARM()
+static constexpr size_t HEAP_REGION_SIZE = 256ull * MiB;
 #elif AK_IS_ARCH_AARCH64() && !defined(AK_OS_MACOS)
 // Some AArch64 systems provide only 39 or 42 bits of user virtual address
 // space. Keep the cage small enough to fit those systems, including the
diff --git a/Libraries/LibGC/NanBoxedValue.h b/Libraries/LibGC/NanBoxedValue.h
index 1428825..d34feeb 100644
--- a/Libraries/LibGC/NanBoxedValue.h
+++ b/Libraries/LibGC/NanBoxedValue.h
@@ -14,7 +14,7 @@
 namespace GC {
 
 static_assert(sizeof(double) == 8);
-static_assert(sizeof(void*) == sizeof(u64));
+static_assert(sizeof(void*) <= sizeof(u64));
 // To make our Value representation compact we can use the fact that IEEE
 // doubles have a lot (2^52 - 2) of NaN bit patterns. The canonical form being
 // just 0x7FF8000000000000 i.e. sign = 0 exponent is all ones and the top most
-- 
