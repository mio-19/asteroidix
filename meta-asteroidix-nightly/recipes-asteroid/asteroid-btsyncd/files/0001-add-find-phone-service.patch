+#ifndef FINDPHONESERVICE_H
+#define FINDPHONESERVICE_H
+
+#include <QTimer>
+
+#include "service.h"
+
+class FindPhoneRingChrc : public Characteristic
+{
+    Q_OBJECT
+    Q_PROPERTY(QByteArray Value READ getValue NOTIFY valueChanged)
+
+public:
+    FindPhoneRingChrc(QDBusConnection bus, int index, Service *service);
+    void request(bool ring);
+
+signals:
+    void valueChanged();
+
+private slots:
+    void emitPropertiesChanged();
+
+private:
+    QByteArray getValue() { return m_value; }
+    QByteArray m_value;
+
+public slots:
+    QByteArray ReadValue(QVariantMap options) override;
+    void StartNotify() override {}
+    void StopNotify() override {}
+};
+
+class FindPhoneApi : public QObject
+{
+    Q_OBJECT
+    Q_CLASSINFO("D-Bus Interface", FINDPHONE_IFACE)
+    Q_PROPERTY(bool Ringing READ ringing NOTIFY ringingChanged)
+
+public:
+    explicit FindPhoneApi(FindPhoneRingChrc *chrc, QObject *parent = nullptr);
+    bool ringing() const { return m_ringing; }
+
+signals:
+    void ringingChanged();
+
+public slots:
+    void Ring();
+    void Stop();
+
+private:
+    FindPhoneRingChrc *m_chrc;
+    QTimer m_timer;
+    bool m_ringing;
+};
+
+class FindPhoneService : public Service
+{
+public:
+    explicit FindPhoneService(int index, QDBusConnection bus, QObject *parent = nullptr);
+
+private:
+    FindPhoneRingChrc *m_ring;
+    FindPhoneApi *m_api;
+};
+
+#endif
