+#include "findphoneservice.h"
+#include "common.h"
+
+#include <QDBusConnection>
+#include <QDebug>
+
+FindPhoneRingChrc::FindPhoneRingChrc(QDBusConnection bus, int index, Service *service)
+    : Characteristic(bus, index, FINDPHONE_RING_UUID, {"encrypt-authenticated-read", "encrypt-authenticated-notify"}, service)
+{
+    m_value.resize(1);
+    m_value[0] = 0;
+    connect(this, SIGNAL(valueChanged()), this, SLOT(emitPropertiesChanged()));
+}
+
+void FindPhoneRingChrc::request(bool ring)
+{
+    m_value[0] = ring ? 1 : 0;
+    emit valueChanged();
+}
+
+QByteArray FindPhoneRingChrc::ReadValue(QVariantMap)
+{
+    return m_value;
+}
+
+void FindPhoneRingChrc::emitPropertiesChanged()
+{
+    QDBusConnection connection = QDBusConnection::systemBus();
+    QDBusMessage message = QDBusMessage::createSignal(getPath().path(),
+                                                      "org.freedesktop.DBus.Properties",
+                                                      "PropertiesChanged");
+
+    QVariantMap changedProperties;
+    changedProperties[QStringLiteral("Value")] = QVariant(m_value);
+
+    QList<QVariant> arguments;
+    arguments << QVariant(GATT_CHRC_IFACE) << QVariant(changedProperties) << QVariant(QStringList());
+    message.setArguments(arguments);
+
+    if (!connection.send(message))
+        qDebug() << "Failed to send find-phone notification";
+}
+
+FindPhoneApi::FindPhoneApi(FindPhoneRingChrc *chrc, QObject *parent)
+    : QObject(parent), m_chrc(chrc), m_ringing(false)
+{
+    m_timer.setSingleShot(true);
+    m_timer.setInterval(30000);
+    connect(&m_timer, &QTimer::timeout, this, &FindPhoneApi::Stop);
+}
+
+void FindPhoneApi::Ring()
+{
+    m_ringing = true;
+    m_chrc->request(true);
+    m_timer.start();
+    emit ringingChanged();
+}
+
+void FindPhoneApi::Stop()
+{
+    m_timer.stop();
+    m_ringing = false;
+    m_chrc->request(false);
+    emit ringingChanged();
+}
+
+FindPhoneService::FindPhoneService(int index, QDBusConnection bus, QObject *parent)
+    : Service(bus, index, FINDPHONE_UUID, parent)
+{
+    m_ring = new FindPhoneRingChrc(bus, 0, this);
+    addCharacteristic(m_ring);
+    m_api = new FindPhoneApi(m_ring, this);
+
+    QDBusConnection session = QDBusConnection::sessionBus();
+    if (!session.registerService(QStringLiteral(FINDPHONE_SERVICE_NAME)))
+        qWarning() << "find phone service name:" << session.lastError().message();
+    if (!session.registerObject(QStringLiteral(FINDPHONE_PATH), m_api,
+                                QDBusConnection::ExportAllSlots
+                                    | QDBusConnection::ExportAllProperties
+                                    | QDBusConnection::ExportAllSignals))
+        qWarning() << "find phone object:" << session.lastError().message();
+}
